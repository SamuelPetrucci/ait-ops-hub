# Public browser keys from the Vercel Supabase integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Shared password for the ops dashboard. Server only. Changing it signs everyone out.
OPS_PASSWORD=

# Buffer personal API key (Settings → API). Server only. Analytics + scheduling.
BUFFER_API_KEY=
# Optional. Defaults to the AI Transformation Buffer org.
BUFFER_ORGANIZATION_ID=
# Optional channel overrides (defaults are the AI Transformation channels).
BUFFER_CHANNEL_YOUTUBE_VIRAL_DIGESTS=
BUFFER_CHANNEL_YOUTUBE_JOHNNY_SNOW=
BUFFER_CHANNEL_INSTAGRAM=

# --- SMS / iMessage assistant (Linq + AI Gateway) ---
# Linq API token from https://dashboard.linqapp.com/api-tooling/
LINQ_API_KEY=
# Alias accepted by the SDK / CLI if you prefer the V3 name
# LINQ_API_V3_API_KEY=
# Signing secret returned once when you create the webhook subscription (whsec_…)
LINQ_WEBHOOK_SECRET=
# Your personal number in E.164 (+1…). Owner alerts go here; inbound from this number is ignored.
OWNER_PHONE=
# Vercel AI Gateway key (https://vercel.com/docs/ai-gateway). OIDC on Vercel can replace this in prod.
AI_GATEWAY_API_KEY=
# Optional model override (AI Gateway provider/model slug)
SMS_ASSISTANT_MODEL=openai/gpt-4o-mini
