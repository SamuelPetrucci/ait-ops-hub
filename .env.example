# Public browser keys from the Vercel Supabase integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Shared password for the ops dashboard. Server only. Changing it signs everyone out.
OPS_PASSWORD=

# Buffer personal API key (Settings → API). Server only. Analytics + scheduling.
BUFFER_API_KEY=
# Optional. Defaults to the AI Transformation Buffer org.
BUFFER_ORGANIZATION_ID=
# Optional channel overrides (defaults are the AI Transformation channels).
BUFFER_CHANNEL_YOUTUBE_VIRAL_DIGESTS=
BUFFER_CHANNEL_YOUTUBE_JOHNNY_SNOW=
BUFFER_CHANNEL_INSTAGRAM=
